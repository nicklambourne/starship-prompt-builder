{
  "name": "starship-prompt-builder-cli",
  "version": "0.1.0",
  "description": "Build and preview a Starship prompt from your terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicklambourne/starship-prompt-builder.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "starship-builder": "dist/index.js",
    "spb": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && node dist/index.js",
    "test": "vitest run --config vitest.config.mts",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^6.3.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "esbuild": "^0.27.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
