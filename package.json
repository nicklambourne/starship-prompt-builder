{
  "name": "starship-prompt-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run --config vitest.parity.mts",
    "test:e2e": "playwright test",
    "serve:export": "node scripts/serve-export.mjs",
    "sync:schema": "curl -fsSL https://starship.rs/config-schema.json -o data/config-schema.json",
    "sync:docs": "curl -fsSL https://raw.githubusercontent.com/starship/starship/master/docs/config/README.md -o data/config-docs.md",
    "build:schema": "node scripts/build-schema.mjs",
    "build:presets": "node scripts/build-presets.mjs",
    "build:glyphs": "node scripts/build-glyphs.mjs",
    "build:module-docs": "node scripts/build-module-docs.mjs",
    "build:data": "pnpm build:schema && pnpm build:presets && pnpm build:glyphs && pnpm build:module-docs",
    "build:fonts": "node scripts/build-font-subsets.mjs",
    "build:og": "node scripts/build-og-image.mjs",
    "build:screenshots": "node scripts/build-screenshots.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip"
  },
  "dependencies": {
    "@heroui/styles": "^3.2.1",
    "lz-string": "^1.5.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "19.2.8",
    "smol-toml": "^1.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fontverter": "2.0.0",
    "knip": "6.33.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
